@using BookHeaven.Core.Features.Fonts
@using BookHeaven.Core.Features.Reader.Abstractions
<MudDialog>
	<TitleContent>
		<h3>Text Settings</h3>
	</TitleContent>
	<DialogContent>
		<div class="grid grid-cols-[min-content_1fr] gap-5 mb-4" @onclick:stopPropagation="true">
			<MudSelect
				OuterClass="col-span-2"
				Label="Font"
				@bind-Value="ReaderSettingsService.ReaderSettings!.SelectedFont" 
				@bind-Value:after="() => ReaderSettingsService.NotifySettingsChanged()"
				Variant="Variant.Outlined">
				<MudSelectItem Value="@(string.Empty)">Default</MudSelectItem>
				@foreach (var font in _fonts)
				{
					<MudSelectItem Value="@font.Family">@font.Family</MudSelectItem>
				}
			</MudSelect>
			<RangeSlider Label="Font Size" Min="10" Max="32" @bind-Value="@ReaderSettingsService.ReaderSettings!.FontSize" @bind-Value:after="() => ReaderSettingsService.NotifySettingsChanged()"/>
			<RangeSlider Label="Letter Spacing" Min="0" Max="2" Increment="0.1m" @bind-Value="@ReaderSettingsService.ReaderSettings.LetterSpacing" @bind-Value:after="() => ReaderSettingsService.NotifySettingsChanged()" />
			@* <TextSetting Label="Word Spacing" Min="0" Max="5" Increment="0.25" @bind-Value="ReaderService.ProfileSettings.WordSpacing" /> *@
			<RangeSlider Label="Line Height" Min="1.2m" Max="2.5m" Increment="0.05m" @bind-Value="@ReaderSettingsService.ReaderSettings.LineHeight" @bind-Value:after="() => ReaderSettingsService.NotifySettingsChanged()"/>
			<RangeSlider Label="Text Indent" Min="0" Max="3" Increment="0.5m" @bind-Value="@ReaderSettingsService.ReaderSettings.TextIndent" @bind-Value:after="() => ReaderSettingsService.NotifySettingsChanged()"/>
			<RangeSlider Label="Paragraph Spacing" Min="0" Max="20" Increment="2" @bind-Value="@ReaderSettingsService.ReaderSettings.ParagraphSpacing" @bind-Value:after="() => ReaderSettingsService.NotifySettingsChanged()"/>
		</div>
	</DialogContent>
</MudDialog>

@code {
	[Inject] private IReaderSettingsService ReaderSettingsService { get; set; } = null!;
	[Inject] private ISender Sender { get; set; } = null!;
	
	[CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
	
	readonly List<Font> _fonts = [];
	
	protected override async Task OnInitializedAsync()
	{
		var getVariants = await Sender.Send(new GetAllFonts.Query());
		if (getVariants.IsSuccess)
		{
			_fonts.AddRange(getVariants.Value.GroupBy(v => v.Family).Select(v => v.First()));
		}
	}
}