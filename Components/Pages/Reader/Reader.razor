@using System.Globalization
@using BookHeaven.Core.DOM.Text.Abstractions
@using BookHeaven.Core.DOM.Text.Enums
@using BookHeaven.Core.Features.Reader.Abstractions
@using BookHeaven.Core.Features.Reader.Models
@using BookHeaven.Server.Components.Pages.Reader.Components
@using BookHeaven.Server.Components.Pages.Reader.Components.Settings
@using BookHeaven.Server.Components.Pages.Reader.Components.TableOfContents
@using BookHeaven.Server.Features.Authentication.Abstractions
@attribute [Route($"{Urls.Reader}/{{BookId:guid}}")]
@layout EmptyLayout
@implements IAsyncDisposable
<!--suppress CssUnresolvedCustomProperty -->
<style>
	html {
		font-size: 16px;
	}

	body {
		margin: 0 !important;
		overflow: hidden;
	}

	@@scope (#viewer) {
		:scope {
			container-type: size;
			--column-count: 1;
			--chapter-page: @ReaderService.State?.PageNumber;
			--font-size: @ReaderService.Settings?.FontSize.ToString("0.00", CultureInfo.InvariantCulture);
			--line-height: @ReaderService.Settings?.LineHeight.ToString("0.00", CultureInfo.InvariantCulture);
			--letter-spacing: @ReaderService.Settings?.LetterSpacing.ToString("0.00", CultureInfo.InvariantCulture);
			--paragraph-spacing: @ReaderService.Settings?.ParagraphSpacing.ToString("0.00", CultureInfo.InvariantCulture);
			--text-indent: @ReaderService.Settings?.TextIndent.ToString("0.00", CultureInfo.InvariantCulture);
			--word-spacing: @ReaderService.Settings?.WordSpacing.ToString("0.00", CultureInfo.InvariantCulture);
			--margin-vertical: @ReaderService.Settings?.VerticalMargin.ToString("0.00", CultureInfo.InvariantCulture);
			--margin-horizontal: @ReaderService.Settings?.HorizontalMargin.ToString("0.00", CultureInfo.InvariantCulture);
			--page-gap: var(--margin-horizontal);
			--page-height: 100cqh;
			--page-width: 100cqw;

			& .page-divider {
				display: none;
			}

			@@media (min-width: 800px) and (orientation: landscape) {
				--column-count: 2;
				--page-gap: calc(var(--margin-horizontal) * 2);
				--page-width: calc((100cqw - (var(--page-gap) * 1rem)) / 2);

				& .page-divider {
					display: block;
				}
			}

			margin: calc(var(--margin-vertical) * 1rem) calc(var(--margin-horizontal) * 1rem);


			& > .chapter {
				height: var(--page-height);
				column-width: var(--page-width);
				font-size: calc(var(--font-size) * 1px) !important;
				line-height: @ITextMeasurer.NormalLineHeightMultiplier.ToString("0.00", CultureInfo.InvariantCulture);
				letter-spacing: calc(var(--letter-spacing) * 1px);
				column-fill: auto;
				column-gap: calc(var(--page-gap) * 1rem);
				padding: 0;
				orphans: 1;
				widows: 1;


				&.current {
					transform: translateX(
						calc(
							(var(--page-width) + (var(--page-gap) * 1rem))
							* (var(--chapter-page) - 1)
							* var(--column-count)
							* -1
						)
					);
				}

				& p {
					word-break: auto-phrase !important;
					hyphens: none !important;
				}
			}
		}

		h1 {
			@@apply text-4xl;
		}

		h2 {
			@@apply text-3xl;
		}

		h3 {
			@@apply text-2xl;
		}

		h4 {
			@@apply text-xl;
		}

		h5 {
			@@apply text-lg;
		}

		h6 {
			@@apply text-base;
		}

		table {
			table-layout: fixed !important;
		}

		img, svg, figure {
			box-sizing: border-box;
			object-fit: contain !important;
			break-inside: avoid !important;
			max-width: 100%;
			max-height: var(--page-height) !important;
			float: none !important;
		}

		:scope > .chapter p:not([class]) {
			margin-block: calc(var(--paragraph-spacing) * 1pt) !important;
		}

		:scope sup {
			font-size: 0.6em;
			line-height: normal;
			font-weight: bold;
		}

		@@supports (initial-letter: 2) {
			:scope .drop-cap {
				orphans: 2;
				display: flow-root;
				&::first-letter {
					initial-letter: 2;
					margin-inline-end: 0.3em;
				}

				& + p {
					clear: both;
				}
			}
		}

		@if (!string.IsNullOrEmpty(ReaderService.State?.CurrentChapter?.ParagraphClassName))
		{
			<text>
			:scope > .chapter p@("." + ReaderService.State?.CurrentChapter?.ParagraphClassName) {
				margin-block: calc(var(--paragraph-spacing) * 1pt) !important;
			}
			</text>
		}

		@foreach (var stylesheet in ReaderService.State?.Styles ?? [])
		{
			<text>
			:scope @(".stylesheet-" + stylesheet.Identifier) {
				@stylesheet.Content
			}
			</text>
		}
		
	}
</style>

@if (!ReaderService.IsReady)
{
	<div class="fixed inset-0 z-10000 flex items-center justify-center">
		<MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
	</div>
}
else {
	<PageTitle>@Translations.READING: @ReaderService.State?.Ebook?.Title | BookHeaven</PageTitle>
    <FontProvider />
}
<MudDrawer  @bind-Open="_showIndex" Variant="DrawerVariant.Temporary" OverlayAutoClose="true">
	<TableOfContents
		Chapters="@ReaderService.State?.Ebook?.Content.TableOfContents"
		CurrentChapterId="@ReaderService.State?.CurrentChapter?.Identifier"/>
</MudDrawer>
<div class="flex h-dvh w-dvw flex-col 2xl:relative 2xl:px-50 2xl:py-20 @(ReaderService.IsReady ? "" : "opacity-0")">
	<div class="flex items-center gap-2 2xl:absolute 2xl:inset-x-0 2xl:top-0 2xl:p-5">
		<GoBackButton/>
		@if (ReaderService.IsReady)
		{
			<span class="xl:text-lg">@ReaderService.State?.Ebook?.Title</span>
			<div class="ms-auto flex items-center 2xl:gap-2">
				<MudIconButton Icon="@Icons.Material.Filled.TextFields" OnClick="OpenTextSettingsDialog"/>
				<MudIconButton Icon="@Icons.Material.Filled.Settings" OnClick="OpenPageSettingsDialog"/>
				<MudIconButton Icon="@(_isFullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" OnClick="ToggleFullscreen"/>
			</div>
		}
	</div>
	<div class="relative flex flex-1 bg-white dark:bg-neutral-900">
		<NavigationOverlay />
		<div id="viewer" class="flex-1 overflow-hidden @(_readerState == ReaderState.Ready ? "" : "opacity-0")">
			<span class="page-divider absolute inset-y-0 left-[50%] -translate-x-1/2 border border-neutral-200 dark:border-neutral-600"></span>
			<div class="chapter current @(string.Join(" ", ReaderService.State?.CurrentChapter?.Stylesheets.Select(s => "stylesheet-" + s) ?? []))">
				@if (ReaderService.State?.CurrentChapter is not null)
				{
					@((MarkupString)ReaderService.State.CurrentChapter.Content)
				}
			</div>
		</div>
	</div>
	<div class="grid grid-cols-[50px_1fr_50px] items-center gap-2 px-2 2xl:absolute 2xl:inset-x-0 2xl:bottom-0 2xl:p-5">
		<span>
			<MudIconButton Icon="@Icons.Material.Filled.List" OnClick="() => _showIndex = !_showIndex" Edge="Edge.Start"/>
		</span>
		<div class="flex items-center flex-wrap">
			<span class="mx-auto text-nowrap pt-2">
				@ReaderService.State?.ChapterTitle
				( @ReaderService.State?.PageNumber / @ReaderService.State?.TotalPages )
			</span>
			<div class="flex items-center mx-auto">
				<MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="() => ReaderService.PreviousPage()"/>
				<MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowLeft" OnClick="() => ReaderService.PreviousChapter()"/>
				<MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" OnClick="() => ReaderService.NextChapter()"/>
				<MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="() => ReaderService.NextPage()"/>
			</div>
		</div>
		<span class="text-end">
			@ReaderService.State?.ProgressAsPercentage.ToString("0.00")%
		</span>
	</div>
</div>
@code {
	[Inject] private IAuthenticationService AuthenticationService { get; set; } = null!;
	[Inject] private IReaderService ReaderService { get; set; } = null!;
	[Inject] private IReaderSettingsService ReaderSettingsService { get; set; } = null!;
	[Inject] private IJSRuntime JsRuntime { get; set; } = null!;
	[Inject] private IDialogService DialogService { get; set; } = null!;

	[Parameter] public Guid BookId { get; set; }
	
	private DotNetObjectReference<Reader> _dotNetReference = null!;
	private IJSObjectReference? _module;
	
	private ReaderState _readerState = ReaderState.Uninitialized;
	private bool _recountPagesOnNextRender;
	private Guid _assetLoadToken = Guid.NewGuid();
	
	private bool _isFullscreen;
	private bool _showIndex;

	protected override async Task OnInitializedAsync()
	{
		ReaderService.OnPageChanged += RefreshUi;
		ReaderService.OnChapterChanged += OnChapterChanged;
		ReaderService.OnTotalPagesChanged += RefreshUi;
		ReaderSettingsService.OnSettingChanged += OnSettingChanged;

		var selectedProfile = await AuthenticationService.GetSelectedProfileAsync();
		await ReaderService.InitializeAsync(BookId, selectedProfile!.ProfileId);
		_readerState = ReaderState.Initialized;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			_module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Reader/Reader.razor.js");
			_dotNetReference = DotNetObjectReference.Create(this);
			await _module.InvokeVoidAsync("Initialize", _dotNetReference);
		}
		
		if(_module is null) return;

		switch (_readerState)
		{
			case ReaderState.Initialized:
				var readerContext = await GetReaderContextAsync();
				await ReaderService.LoadCachedPagesAsync(readerContext);
				if (ReaderService.State?.PagesPerChapter.Length > 0)
				{
					ReaderService.NavigateToInitialPage();
				}
				else
				{
					await UpdateTotalPages();
				}
				_assetLoadToken = Guid.NewGuid();
				_readerState = ReaderState.WaitingForAssets;
				StateHasChanged();
				break;
			case ReaderState.WaitingForAssets:
				var assetLoadToken = _assetLoadToken;
				await _module!.InvokeVoidAsync("WaitForAssetsToLoad");
				if (assetLoadToken != _assetLoadToken || _readerState != ReaderState.WaitingForAssets)
				{
					break;
				}

				_readerState = ReaderState.Ready;
				StateHasChanged();
				break;
		}
		
		if (_recountPagesOnNextRender)
		{
			_recountPagesOnNextRender = false;
			_ = UpdateTotalPages();
		}
	}
	
	private async Task UpdateTotalPages()
	{
		if(_module is null) return;
		var context = await GetReaderContextAsync();
		await ReaderService.CalculatePagesAsync(context);
		if (!ReaderService.IsReady)
		{
			ReaderService.NavigateToInitialPage();
		}
	}

	private void RefreshUi()
	{
		InvokeAsync(StateHasChanged);
	}

	private void OnChapterChanged()
	{
		_assetLoadToken = Guid.NewGuid();
		_readerState = ReaderState.WaitingForAssets;
		RefreshUi();
	}

	private void OnSettingChanged(string? settingName)
	{
		_recountPagesOnNextRender = true;
		RefreshUi();
	}
	
	private async Task<ReaderContext> GetReaderContextAsync()
	{
		if(_module is null) throw new InvalidOperationException("JS module is not initialized.");
		var info = await _module.InvokeAsync<ReaderContextInfo>("GetReaderContext");
		var mode = info.Engine == "gecko" ? LineBreakingMode.Firefox : LineBreakingMode.Chrome;
		return new ReaderContext
		{
			ViewportWidth = info.ViewportWidth,
			ViewportHeight = info.ViewportHeight,
			PageWidth = (int)info.PageWidth,
			PageHeight = (int)info.PageHeight,
			LineBreakingMode = mode,
			ColumnCount = info.ColumnCount
		};
	}

	[JSInvokable("OnKeyDown")]
	public void OnKeyDown(string key)
	{
		switch (key)
		{
			case "PageDown" or "ArrowRight":
				ReaderService.NextPage();
				break;
			case "PageUp" or "ArrowLeft":
				ReaderService.PreviousPage();
				break;
		}
	}

	[JSInvokable("OnViewportChanged")]
	public async Task OnViewportChanged()
	{
		if(!ReaderService.IsReady || _readerState != ReaderState.Ready) return;
		_recountPagesOnNextRender = true;
		await InvokeAsync(StateHasChanged);
	}
	private async Task OpenTextSettingsDialog()
	{
		await DialogService.ShowAsync<TextSettingsDialog>();
	}
	private async Task OpenPageSettingsDialog()
	{
		await DialogService.ShowAsync<PageSettingsDialog>();
	}
	
	private async Task ToggleFullscreen()
	{
		if(_module is null) return;
		if (_isFullscreen)
		{
			await _module.InvokeVoidAsync("ExitFullscreen");
		}
		else
		{
			await _module.InvokeVoidAsync("EnterFullscreen");
		}
	}
	
	[JSInvokable("OnFullscreenChanged")]
	public async Task OnFullscreenChanged(bool isFullscreen)
	{
		_isFullscreen = isFullscreen;
		await InvokeAsync(StateHasChanged);
	}

	public async ValueTask DisposeAsync()
	{
		await ReaderService.SaveProgressAsync();
		ReaderService.OnPageChanged -= RefreshUi;
		ReaderService.OnChapterChanged -= OnChapterChanged;
		ReaderService.OnTotalPagesChanged -= RefreshUi;
		ReaderSettingsService.OnSettingChanged -= OnSettingChanged;
		ReaderService.Dispose();
		_dotNetReference.Dispose();
		try
		{
			if (_module is not null)
			{
				await _module.InvokeVoidAsync("Dispose");
				await _module.DisposeAsync();
			}
		}
		catch {}

	}
	
	private record ReaderContextInfo(int ViewportWidth, int ViewportHeight, double PageWidth, double PageHeight, string Engine, int ColumnCount);
	
	private enum ReaderState
	{
		Uninitialized,
		Initialized,
		WaitingForAssets,
		Ready
	}
}