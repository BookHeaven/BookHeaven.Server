@using BookHeaven.Server.Components.Pages.Profiles
@using Microsoft.AspNetCore.Components.Authorization

<AppShell>
	<CascadingAuthenticationState>
		<Router AppAssembly="@typeof(Program).Assembly" OnNavigateAsync="OnNavigateAsync">
			<Found Context="routeData">
				<AuthorizeRouteView RouteData="routeData">
					<NotAuthorized>
						<LayoutView Layout="typeof(SimpleLayout)">
							<ProfilesPage />
						</LayoutView>
					</NotAuthorized>
					<Authorizing>
						<LayoutView Layout="typeof(EmptyLayout)">
							<LoadingScreen />
						</LayoutView>
					</Authorizing>
				</AuthorizeRouteView>
				<FocusOnNavigate RouteData="@routeData" Selector="[autofocus]"/>
			</Found>
			<NotFound>
				<LayoutView Layout="@typeof(EmptyLayout)">
					<PageTitle>404 - Not found</PageTitle>
					<div class="inset-0 absolute flex flex-col items-center justify-center">
						<h1 class="text-5xl mb-5">Whatever you are looking for, it's gone</h1>
					</div>
				</LayoutView>
			</NotFound>
		</Router>
	</CascadingAuthenticationState>
</AppShell>

@code
{
	[Inject] private IViewTransition ViewTransition { get; set; } = null!;
	
	private async Task OnNavigateAsync()
	{
		await ViewTransition.BeginAsync();
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		await ViewTransition.EndAsync();
	}
}
