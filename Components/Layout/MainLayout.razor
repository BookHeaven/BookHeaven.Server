@using BookHeaven.Server.Features.Authentication.Abstractions
@using BookHeaven.Server.Features.Authentication.Models
@inherits LayoutComponentBase
<PageTitle>BookHeaven</PageTitle>

@if (!_isInitialized)
{
    <LoadingScreen />
    return;
}

<CascadingValue Value="SelectedProfile">
    <div class="relative flex h-full overflow-hidden">
        <MudDrawer @bind-Open="_drawerOpen" Class="lg:static" Elevation="0">
            <Logo />
            <ProfileButton />
            <NavMenu/>
            <div class="mt-auto grid gap-5 p-5">
                <EbookLoadInfo />
                <div class="flex items-center justify-between gap-2">
                    <MudIconButton 
                        Href="https://github.com/bookheaven/bookheaven.server"
                        Target="_blank"
                        Icon="@Icons.Custom.Brands.GitHub" 
                        Color="Color.Secondary" />
                    <VersionInfo/>
                </div>
            </div>
        </MudDrawer>
        <main class="flex w-full flex-col overflow-y-auto">
            <div class="sticky top-0 z-20 flex flex-col-reverse gap-2 bg-(--mud-palette-appbar-background) px-2 py-2 backdrop-blur lg:flex-row lg:py-3 2xl:px-3" style="view-transition-name:appbar;">
                <div class="flex flex-1 items-center gap-3">
                    <SectionOutlet SectionName="TopBar" />
                </div>
                <div class="flex items-center">
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.False" OnClick="@((e) => _drawerOpen = !_drawerOpen)"/>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.MdAndDown">
                        <MudSpacer />
                    </MudHidden>
                    <SearchBar/>
                
                    <EbookUploadButton />
                </div>
            </div>
            <div class="relative flex-1 overflow-x-hidden py-2 md:px-7 lg:py-5">
                <SectionOutlet SectionName="Toolbar" />
                @Body
            </div>
            <SectionOutlet SectionName="BottomToolbar" />
        </main>
    </div>
</CascadingValue>

@code {
    [Inject] private IAuthenticationService AuthenticationService { get; set; } = null!;

    private SelectedProfile? SelectedProfile { get; set; }
    
    private bool _drawerOpen = true;
    
    private bool _isInitialized;

    protected override async Task OnInitializedAsync()
    {
        SelectedProfile = await AuthenticationService.GetSelectedProfileAsync();
        _isInitialized = true;
    }

}