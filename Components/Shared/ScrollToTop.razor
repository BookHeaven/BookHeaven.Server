@code {
    [Inject] IJSRuntime JsRuntime { get; set; } = null!;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JsRuntime.InvokeVoidAsync("scrollToTop");
            }
            catch
            {
                // Ignore errors
            }
        }
    }
}